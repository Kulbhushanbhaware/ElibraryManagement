<style>
    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }
    
    .form-group {
        margin-bottom: 1rem;
    }
    
    .form-text {
        font-size: 0.875em;
    }
    
    .btn {
        margin-right: 0.5rem;
    }
    
    textarea.form-control {
        resize: vertical;
        min-height: 80px;
