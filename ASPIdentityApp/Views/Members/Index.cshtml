@model IEnumerable<ASPIdentityApp.Models.Member>
@{
    ViewData["Title"] = "Member Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-users me-2"></i>Member Management</h1>
        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Add New Member
            </a>
        }
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h5>Total Members</h5>
                    <h3>@Model.Count()</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h5>Active Members</h5>
                    <h3>@Model.Count(m => m.Status == "Active")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body text-center">
                    <h5>Expired Memberships</h5>
                    <h3>@Model.Count(m => m.MembershipExpiry < DateTime.Now)</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h5>Inactive Members</h5>
                    <h3>@Model.Count(m => m.Status == "Inactive")</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Member Code</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Registration Date</th>
                                <th>Membership Expiry</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.MemberCode</strong>
                                    </td>
                                    <td>
                                        @item.FirstName @item.LastName
                                        @if (item.MembershipExpiry < DateTime.Now)
                                        {
                                            <br />
                                
                                            <small class="text-danger">Membership Expired</small>
                                        }
                                    </td>
                                    <td>@item.Email</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                        {
                                            @item.PhoneNumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not provided</span>
                                        }
                                    </td>
                                    <td>@item.RegistrationDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="@(item.MembershipExpiry < DateTime.Now ? "text-danger fw-bold" : "")">
                                            @item.MembershipExpiry.ToString("MMM dd, yyyy")
                                            @if (item.MembershipExpiry < DateTime.Now)
                                            {
                                                <br />
                                    
                                                <small class="text-danger">(@((DateTime.Now - item.MembershipExpiry).Days) days ago)</small>
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(item.Status)">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Edit Member">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Delete Member">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-users fa-3x text-muted mb-3"></i>
                    <h4>No Members Found</h4>
                    <p class="text-muted">Get started by adding your first member to the system.</p>
                    @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                    {
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i>Add First Member
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@functions {
    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Active" => "bg-success",
            "Inactive" => "bg-secondary",
            "Suspended" => "bg-danger",
            _ => "bg-warning"
        };
    }
}

@section Scripts {
    <script>
        // Add any JavaScript functionality here if needed
        console.log('Member management page loaded');

        // Auto-dismiss alerts after 5 seconds
        setTimeout(function() {
            $('.alert').alert('close');
        }, 5000);
    </script>
}

<style>
    .table th {
        font-weight: 600;
        border-bottom: 2px solid #dee2e6;
    }

    .badge {
        font-size: 0.75em;
        padding: 0.4em 0.6em;
    }

    .btn-group .btn {
        margin-right: 0.25rem;
    }

    .card .card-body h3 {
        margin: 0;
        font-weight: bold;
    }

    .table tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.02);
    }
</style>