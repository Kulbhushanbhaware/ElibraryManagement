@using ASPIdentityApp.Models
@model IEnumerable<ASPIdentityApp.Models.Book>
@{
    ViewData["Title"] = "Browse Books";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-search me-2"></i>Browse Available Books</h1>
        <a asp-controller="BookIssues" asp-action="MyIssues" class="btn btn-outline-primary">
            <i class="fas fa-book me-1"></i>My Issued Books
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        @foreach (var book in Model.Where(b => b.AvailableCopies > 0))
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@book.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            by @book.Author.FirstName @book.Author.LastName
                        </h6>
                        <p class="card-text">
                            @if (!string.IsNullOrEmpty(book.Description) && book.Description.Length > 100)
                            {
                                @book.Description.Substring(0, 100)
                        
                                <text>...</text>
                            }
                            else
                            {
                                @book.Description
                            }
                        </p>

                        <div class="book-details">
                            <p class="mb-1"><strong>Publisher:</strong> @book.Publisher.Name</p>
                            <p class="mb-1"><strong>ISBN:</strong> @book.ISBN</p>
                            <p class="mb-1"><strong>Genre:</strong> @(string.IsNullOrEmpty(book.Genre) ? "General" : book.Genre)</p>
                            <p class="mb-1">
                                <strong>Available Copies:</strong>
                                <span class="badge bg-success">@book.AvailableCopies</span>
                            </p>
                        </div>
                    </div>
                    <div class="card-footer">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="BookIssues" asp-action="SelfIssue" method="post">
                                <input type="hidden" name="bookId" value="@book.Id" />
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-bookmark me-1"></i>Issue This Book
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary w-100">
                                <i class="fas fa-sign-in-alt me-1"></i>Login to Issue
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any(b => b.AvailableCopies > 0))
    {
        <div class="text-center py-5">
            <i class="fas fa-book-open fa-4x text-muted mb-3"></i>
            <h4>No Books Available</h4>
            <p class="text-muted">All books are currently issued. Please check back later.</p>
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

    .book-details {
        font-size: 0.9rem;
    }
</style>
