@using ASPIdentityApp.Areas.Identity.Data
@using Microsoft.EntityFrameworkCore
@model ASPIdentityApp.Models.Book
@inject ApplicationDbContext _context
@{
    ViewData["Title"] = "Book Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="fas fa-book me-2"></i>Book Details</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Basic Information</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Title:</dt>
                                <dd class="col-sm-8">@Model.Title</dd>

                                <dt class="col-sm-4">ISBN:</dt>
                                <dd class="col-sm-8">@Model.ISBN</dd>

                                <dt class="col-sm-4">Author:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Author != null)
                                    {
                                        @Model.Author.FirstName @Model.Author.LastName
                                    }
                                    else
                                    {
                                        <span class="text-muted">Author not found</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Publisher:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Publisher != null)
                                    {
                                        @Model.Publisher.Name
                                    }
                                    else
                                    {
                                        <span class="text-muted">Publisher not found</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Published Date:</dt>
                                <dd class="col-sm-8">@Model.PublishedDate.ToString("MMM dd, yyyy")</dd>

                                <dt class="col-sm-4">Genre:</dt>
                                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Genre) ? "Not specified" : Model.Genre)</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h5>Inventory Information</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Total Copies:</dt>
                                <dd class="col-sm-8">@Model.TotalCopies</dd>

                                <dt class="col-sm-4">Available Copies:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge @(Model.AvailableCopies > 0 ? "bg-success" : "bg-danger")">
                                        @Model.AvailableCopies
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Currently Issued:</dt>
                                <dd class="col-sm-8">@(Model.TotalCopies - Model.AvailableCopies)</dd>

                                <dt class="col-sm-4">Added Date:</dt>
                                <dd class="col-sm-8">@Model.CreatedDate.ToString("MMM dd, yyyy")</dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Description</h5>
                                <p class="text-muted">@Model.Description</p>
                            </div>
                        </div>
                    }

                    <!-- Current Issues Section -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <h5>Currently Issued To</h5>
                            @{
                                var currentIssues = await GetCurrentIssues(Model.Id);
                            }
                            @if (currentIssues.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped">
                                        <thead>
                                            <tr>
                                                <th>Member Name</th>
                                                <th>Member Code</th>
                                                <th>Issue Date</th>
                                                <th>Due Date</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var issue in currentIssues)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (issue.Member != null)
                                                        {
                                                            @issue.Member.FirstName @issue.Member.LastName
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Member not found</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (issue.Member != null)
                                                        {
                                                            @issue.Member.MemberCode
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">N/A</span>
                                                        }
                                                    </td>
                                                    <td>@issue.IssueDate.ToString("MMM dd, yyyy")</td>
                                                    <td class="@(issue.DueDate < DateTime.Now ? "text-danger fw-bold" : "")">
                                                        @issue.DueDate.ToString("MMM dd, yyyy")
                                                    </td>
                                                    <td>
                                                        <span class="badge @(issue.Status == "Issued" ? "bg-warning" : "bg-danger")">
                                                            @issue.Status
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">This book is not currently issued to any members.</p>
                            }
                        </div>
                    </div>

                    <!-- Book Issues History -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <h5>Issue History</h5>
                            @{
                                var allIssues = await GetAllIssues(Model.Id);
                            }
                            @if (allIssues.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped">
                                        <thead>
                                            <tr>
                                                <th>Member Name</th>
                                                <th>Member Code</th>
                                                <th>Issue Date</th>
                                                <th>Due Date</th>
                                                <th>Return Date</th>
                                                <th>Status</th>
                                                <th>Fine</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var issue in allIssues)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (issue.Member != null)
                                                        {
                                                            @issue.Member.FirstName @issue.Member.LastName
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Member not found</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (issue.Member != null)
                                                        {
                                                            @issue.Member.MemberCode
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">N/A</span>
                                                        }
                                                    </td>
                                                    <td>@issue.IssueDate.ToString("MMM dd, yyyy")</td>
                                                    <td>@issue.DueDate.ToString("MMM dd, yyyy")</td>
                                                    <td>
                                                        @if (issue.ReturnDate.HasValue)
                                                        {
                                                            @issue.ReturnDate.Value.ToString("MMM dd, yyyy")
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Not returned</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge @GetStatusBadgeClass(issue.Status)">
                                                            @issue.Status
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (issue.FineAmount > 0)
                                                        {
                                                            <span class="text-danger fw-bold">$@issue.FineAmount.ToString("F2")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">$0.00</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No issue history found for this book.</p>
                            }
                        </div>
                    </div>

                    <div class="form-group mt-4">
                        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private async Task<List<BookIssue>> GetCurrentIssues(int bookId)
    {
        return await _context.BookIssues
            .Where(bi => bi.BookId == bookId && bi.Status == "Issued")
            .Include(bi => bi.Member)
            .OrderByDescending(bi => bi.IssueDate)
            .ToListAsync();
    }

    private async Task<List<BookIssue>> GetAllIssues(int bookId)
    {
        return await _context.BookIssues
            .Where(bi => bi.BookId == bookId)
            .Include(bi => bi.Member)
            .OrderByDescending(bi => bi.IssueDate)
            .Take(20) // Limit to last 20 issues for performance
            .ToListAsync();
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Issued" => "bg-warning",
            "Returned" => "bg-success",
            "Overdue" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}

@section Scripts {
    <script>
        // You can add any JavaScript here if needed
        console.log('Book details page loaded');
    </script>
}

<style>
    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }

    .badge {
        font-size: 0.75em;
        padding: 0.4em 0.6em;
    }

    dl.row dt {
        font-weight: 600;
    }

    dl.row dd {
        margin-bottom: 0.5rem;
    }

    .table th {
        font-weight: 600;
        background-color: #f8f9fa;
    }
</style>