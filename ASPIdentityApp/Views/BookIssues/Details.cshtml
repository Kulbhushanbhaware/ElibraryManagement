@model ASPIdentityApp.Models.BookIssue
@{
    ViewData["Title"] = "Book Issue Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="fas fa-info-circle me-2"></i>Book Issue Details</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Book Information</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Title:</dt>
                                <dd class="col-sm-8">@Model.Book.Title</dd>

                                <dt class="col-sm-4">Author:</dt>
                                <dd class="col-sm-8">@Model.Book.Author.FullName</dd>

                                <dt class="col-sm-4">ISBN:</dt>
                                <dd class="col-sm-8">@Model.Book.ISBN</dd>

                                <dt class="col-sm-4">Publisher:</dt>
                                <dd class="col-sm-8">@Model.Book.Publisher.Name</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h5>Issue Details</h5>
                            <dl class="row">
                                <dt class="col-sm-4">Issue Date:</dt>
                                <dd class="col-sm-8">@Model.IssueDate.ToString("MMM dd, yyyy")</dd>

                                <dt class="col-sm-4">Due Date:</dt>
                                <dd class="col-sm-8">
                                    <span class="@(Model.DueDate < DateTime.Now && Model.Status != "Returned" ? "text-danger fw-bold" : "")">
                                        @Model.DueDate.ToString("MMM dd, yyyy")
                                    </span>
                                </dd>

                                <dt class="col-sm-4">Return Date:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.ReturnDate.HasValue)
                                    {
                                        @Model.ReturnDate.Value.ToString("MMM dd, yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not returned yet</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Status:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Status == "Issued")
                                    {
                                        <span class="badge bg-warning">@Model.Status</span>
                                    }
                                    else if (Model.Status == "Returned")
                                    {
                                        <span class="badge bg-success">@Model.Status</span>
                                    }
                                    else if (Model.Status == "Overdue")
                                    {
                                        <span class="badge bg-danger">@Model.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Model.Status</span>
                                    }
                                </dd>

                                <dt class="col-sm-4">Fine Amount:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.FineAmount > 0)
                                    {
                                        <span class="text-danger fw-bold">$@Model.FineAmount.ToString("F2")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">$0.00</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <h5>Notes</h5>
                                <p class="text-muted">@Model.Notes</p>
                            </div>
                        </div>
                    }

                    <div class="form-group mt-4">
                        <a asp-action="MyIssues" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to My Issues
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
