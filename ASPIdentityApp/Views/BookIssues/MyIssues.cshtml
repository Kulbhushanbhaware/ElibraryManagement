@model IEnumerable<ASPIdentityApp.Models.BookIssue>
@{
    ViewData["Title"] = "My Issued Books";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-clipboard-list me-2"></i>My Issued Books</h1>
        <a asp-controller="Books" asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-book me-1"></i>Browse More Books
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Book Title</th>
                                <th>Author</th>
                                <th>Issue Date</th>
                                <th>Due Date</th>
                                <th>Return Date</th>
                                <th>Status</th>
                                <th>Fine Amount</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Book.Title</td>
                                    <td>@item.Book.Author.FullName</td>
                                    <td>@item.IssueDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="@(item.DueDate < DateTime.Now && item.Status != "Returned" ? "text-danger fw-bold" : "")">
                                            @item.DueDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.ReturnDate.HasValue)
                                        {
                                            @item.ReturnDate.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not returned</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == "Issued")
                                        {
                                            <span class="badge bg-warning">@item.Status</span>
                                        }
                                        else if (item.Status == "Returned")
                                        {
                                            <span class="badge bg-success">@item.Status</span>
                                        }
                                        else if (item.Status == "Overdue")
                                        {
                                            <span class="badge bg-danger">@item.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.FineAmount > 0)
                                        {
                                            <span class="text-danger fw-bold">$@item.FineAmount.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">$0.00</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i> Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Summary Section -->
                <div class="row mt-4">
                    <div class="col-md-4">
                        <div class="card bg-primary text-white">
                            <div class="card-body text-center">
                                <h5>Currently Issued</h5>
                                <h3>@Model.Count(i => i.Status == "Issued")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-success text-white">
                            <div class="card-body text-center">
                                <h5>Returned</h5>
                                <h3>@Model.Count(i => i.Status == "Returned")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-danger text-white">
                            <div class="card-body text-center">
                                <h5>Total Fine</h5>
                                <h3>$@Model.Sum(i => i.FineAmount).ToString("F2")</h3>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-book-open fa-4x text-muted mb-3"></i>
                    <h3>No Books Issued</h3>
                    <p class="text-muted">You haven't issued any books from the library yet.</p>
                    <p>Start exploring our collection and borrow your first book!</p>
                    <a asp-controller="Books" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-book me-1"></i>Browse Books
                    </a>
                </div>
            }
        </div>
    </div>
</div>
