@model IEnumerable<ASPIdentityApp.Models.BookIssue>
@{
    ViewData["Title"] = "Book Issuing Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i>@TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-book-reader me-2"></i>Book Issuing Management</h1>
        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
        {
            <a asp-action="Issue" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>Issue New Book
            </a>
        }
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Book Title</th>
                                <th>Member</th>
                                <th>Issue Date</th>
                                <th>Due Date</th>
                                <th>Return Date</th>
                                <th>Status</th>
                                <th>Fine Amount</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @if (item.Book != null)
                                        {
                                            @item.Book.Title
                                        }
                                        else
                                        {
                                            <span class="text-muted">Book not found</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Member != null)
                                        {
                                            @item.Member.FirstName @item.Member.LastName <br />
                                            <small class="text-muted">(@item.Member.MemberCode)</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Member not found</span>
                                        }
                                    </td>
                                    <td>@item.IssueDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="@(item.DueDate < DateTime.Now && item.Status != "Returned" ? "text-danger fw-bold" : "")">
                                            @item.DueDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.ReturnDate.HasValue)
                                        {
                                            @item.ReturnDate.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not returned</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == "Issued")
                                        {
                                            <span class="badge bg-warning">@item.Status</span>
                                        }
                                        else if (item.Status == "Returned")
                                        {
                                            <span class="badge bg-success">@item.Status</span>
                                        }
                                        else if (item.Status == "Overdue")
                                        {
                                            <span class="badge bg-danger">@item.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Status</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.FineAmount > 0)
                                        {
                                            <span class="text-danger fw-bold">$@item.FineAmount.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">$0.00</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                                            {
                                                @if (item.Status == "Issued")
                                                {
                                                    <a asp-action="Return" asp-route-id="@item.Id" class="btn btn-success btn-sm" title="Return Book">
                                                        <i class="fas fa-undo"></i>
                                                    </a>
                                                }
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Delete Record">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Summary Section -->
                <div class="row mt-4">
                    <div class="col-md-3">
                        <div class="card bg-primary text-white">
                            <div class="card-body text-center">
                                <h5>Total Issues</h5>
                                <h3>@Model.Count()</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-warning text-white">
                            <div class="card-body text-center">
                                <h5>Currently Issued</h5>
                                <h3>@Model.Count(i => i.Status == "Issued")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body text-center">
                                <h5>Returned</h5>
                                <h3>@Model.Count(i => i.Status == "Returned")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-danger text-white">
                            <div class="card-body text-center">
                                <h5>Overdue</h5>
                                <h3>@Model.Count(i => i.Status == "Issued" && i.DueDate < DateTime.Now)</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Fine Summary -->
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="card bg-dark text-white">
                            <div class="card-body text-center">
                                <h5>Total Fines</h5>
                                <h3>$@Model.Sum(i => i.FineAmount).ToString("F2")</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card bg-info text-white">
                            <div class="card-body text-center">
                                <h5>Pending Fines</h5>
                                <h3>$@Model.Where(i => i.Status == "Issued" && i.FineAmount > 0).Sum(i => i.FineAmount).ToString("F2")</h3>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="fas fa-book-open fa-3x text-muted mb-3"></i>
                    <h4>No Book Issues Found</h4>
                    <p class="text-muted">No books have been issued yet.</p>
                    @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                    {
                        <a asp-action="Issue" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i>Issue First Book
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table th {
        font-weight: 600;
        border-bottom: 2px solid #dee2e6;
    }
    
    .badge {
        font-size: 0.75em;
        padding: 0.4em 0.6em;
    }
    
    .btn-group .btn {
        margin-right: 0.25rem;
    }
    
    .card .card-body h3 {
        margin: 0;
        font-weight: bold;
    }
</style>