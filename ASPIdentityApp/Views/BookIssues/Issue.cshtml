@model ASPIdentityApp.Models.BookIssue
@{
    ViewData["Title"] = "Issue New Book";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="fas fa-book me-2"></i>Issue New Book</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Issue">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="BookId" class="control-label">Select Book</label>
                                    <select asp-for="BookId" class="form-control" asp-items="ViewBag.Books">
                                        <option value="">-- Select Book --</option>
                                    </select>
                                    <span asp-validation-for="BookId" class="text-danger"></span>
                                    <small class="form-text text-muted">Only available books are shown</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="MemberId" class="control-label">Select Member</label>
                                    <select asp-for="MemberId" class="form-control" asp-items="ViewBag.Members">
                                        <option value="">-- Select Member --</option>
                                    </select>
                                    <span asp-validation-for="MemberId" class="text-danger"></span>
                                    <small class="form-text text-muted">Only active members are shown</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="control-label">Due Date</label>
                                    <input type="text" class="form-control" value="@DateTime.Now.AddDays(14).ToString("MMM dd, yyyy")" readonly />
                                    <small class="form-text text-muted">Books are due in 14 days</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Notes" class="control-label">Notes (Optional)</label>
                                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Any special notes..."></textarea>
                                    <span asp-validation-for="Notes" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <h6><i class="fas fa-info-circle me-2"></i>Issuing Information</h6>
                            <ul class="mb-0">
                                <li>Books are issued for 14 days</li>
                                <li>Late returns incur a fine of $5 per day</li>
                                <li>Maximum 3 books per member at a time</li>
                            </ul>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-check me-1"></i>Issue Book
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}