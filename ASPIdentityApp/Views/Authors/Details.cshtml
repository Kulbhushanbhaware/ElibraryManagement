@model ASPIdentityApp.Models.Author
@{
    ViewData["Title"] = "Author Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="fas fa-user-edit me-2"></i>Author Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Full Name:</dt>
                        <dd class="col-sm-9">@Model.FullName</dd>

                        <dt class="col-sm-3">Email:</dt>
                        <dd class="col-sm-9">@(Model.Email ?? "Not provided")</dd>

                        <dt class="col-sm-3">Date of Birth:</dt>
                        <dd class="col-sm-9">@Model.DateOfBirth.ToString("MMM dd, yyyy")</dd>

                        <dt class="col-sm-3">Biography:</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Biography) ? "No biography available" : Model.Biography)</dd>
                    </dl>

                    <div class="form-group mt-4">
                        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
