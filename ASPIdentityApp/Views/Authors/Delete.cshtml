@model ASPIdentityApp.Models.Author
@{
    ViewData["Title"] = "Delete Author";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h4><i class="fas fa-exclamation-triangle me-2"></i>Delete Author</h4>
                </div>
                <div class="card-body">
                    <h5 class="text-danger">Are you sure you want to delete this author?</h5>
                    <div class="alert alert-warning">
                        <strong>Warning:</strong> This action cannot be undone. Books associated with this author may be affected.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Full Name:</dt>
                        <dd class="col-sm-9">@Model.FullName</dd>

                        <dt class="col-sm-3">Email:</dt>
                        <dd class="col-sm-9">@(Model.Email ?? "Not provided")</dd>

                        <dt class="col-sm-3">Date of Birth:</dt>
                        <dd class="col-sm-9">@Model.DateOfBirth.ToString("MMM dd, yyyy")</dd>
                    </dl>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="form-group">
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash me-1"></i>Delete
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
