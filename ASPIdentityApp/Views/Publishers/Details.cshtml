@model ASPIdentityApp.Models.Publisher
@{
    ViewData["Title"] = "Publisher Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h4><i class="fas fa-building me-2"></i>Publisher Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Name:</dt>
                        <dd class="col-sm-9">@Model.Name</dd>

                        <dt class="col-sm-3">Address:</dt>
                        <dd class="col-sm-9">@Model.Address</dd>

                        <dt class="col-sm-3">Phone:</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Phone) ? "Not provided" : Model.Phone)</dd>

                        <dt class="col-sm-3">Email:</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Email) ? "Not provided" : Model.Email)</dd>
                    </dl>

                    <div class="form-group mt-4">
                        @if (User.IsInRole("Admin") || User.IsInRole("Librarian"))
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
