@{
    ViewData["Title"] = "About Us";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h1><i class="fas fa-info-circle me-2"></i>About E-Library</h1>
                </div>
                <div class="card-body">
                    <h3>Welcome to Our Digital Library</h3>
                    <p class="lead">
                        E-Library is a comprehensive digital library management system designed to provide
                        seamless access to books and resources for our valued members.
                    </p>

                    <h4 class="mt-4">Our Mission</h4>
                    <p>
                        To promote reading culture and provide easy access to knowledge resources through
                        modern technology and user-friendly interfaces.
                    </p>

                    <h4 class="mt-4">What We Offer</h4>
                    <ul>
                        <li>Extensive collection of books across various genres</li>
                        <li>Easy book search and browsing capabilities</li>
                        <li>Digital book issuing and return system</li>
                        <li>Member management and tracking</li>
                        <li>24/7 access to library resources</li>
                    </ul>

                    <h4 class="mt-4">Contact Information</h4>
                    <p>
                        <strong>Address:</strong> 123 Library Street, Knowledge City<br>
                        <strong>Phone:</strong> (555) 123-4567<br>
                        <strong>Email:</strong> info@elibrary.com<br>
                        <strong>Hours:</strong> Monday-Friday: 9AM-6PM, Saturday: 10AM-4PM
                    </p>

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-home me-1"></i>Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
