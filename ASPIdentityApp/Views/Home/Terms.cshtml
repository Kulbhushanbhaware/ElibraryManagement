@{
    ViewData["Title"] = "Terms and Conditions";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h1><i class="fas fa-file-contract me-2"></i>Terms and Conditions</h1>
                </div>
                <div class="card-body">
                    <h4>Membership Terms</h4>
                    <p>
                        By becoming a member of E-Library, you agree to abide by the following terms and conditions:
                    </p>

                    <h5 class="mt-3">1. Membership Eligibility</h5>
                    <ul>
                        <li>Membership is open to individuals aged 12 and above</li>
                        <li>Valid identification is required for registration</li>
                        <li>Membership is non-transferable</li>
                    </ul>

                    <h5 class="mt-3">2. Book Issuing Policy</h5>
                    <ul>
                        <li>Maximum of 3 books can be issued per member at a time</li>
                        <li>Books must be returned within 14 days of issue</li>
                        <li>Late returns will incur fines of $5 per day per book</li>
                        <li>Books can be renewed once if no other member has reserved them</li>
                    </ul>

                    <h5 class="mt-3">3. Responsibilities</h5>
                    <ul>
                        <li>Members are responsible for the care of borrowed materials</li>
                        <li>Lost or damaged books must be replaced or paid for</li>
                        <li>Members must report changes in contact information promptly</li>
                    </ul>

                    <h5 class="mt-3">4. Code of Conduct</h5>
                    <ul>
                        <li>Respect other members and library staff</li>
                        <li>Maintain quiet study environment</li>
                        <li>No food or drinks in reading areas</li>
                        <li>Proper use of library equipment and resources</li>
                    </ul>

                    <div class="alert alert-info mt-4">
                        <strong>Note:</strong> These terms are subject to change. Members will be notified
                        of any changes to the terms and conditions.
                    </div>

                    <div class="mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-home me-1"></i>Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
