@model ASPIdentityApp.Models.DashboardViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 text-center mb-4">Welcome to E-Library</h1>
            <p class="lead text-center">Your digital library management system</p>
        </div>
    </div>

    <!-- Statistics Cards - UPDATED DESIGN -->
    <div class="stats-container mb-5">
        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-book"></i>
            </div>
            <h3 class="stat-title">Total Books</h3>
            <div class="stat-value">@Model.TotalBooks</div>
            <div class="stat-change positive">
                <i class="fas fa-arrow-up"></i> Recently updated
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-user-edit"></i>
            </div>
            <h3 class="stat-title">Authors</h3>
            <div class="stat-value">@Model.TotalAuthors</div>
            <div class="stat-change positive">
                <i class="fas fa-arrow-up"></i> Active contributors
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-users"></i>
            </div>
            <h3 class="stat-title">Members</h3>
            <div class="stat-value">@Model.TotalMembers</div>
            <div class="stat-change positive">
                <i class="fas fa-arrow-up"></i> Growing community
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">
                <i class="fas fa-book-open"></i>
            </div>
            <h3 class="stat-title">Books Issued</h3>
            <div class="stat-value">@Model.IssuedBooks</div>
            <div class="stat-change positive">
                <i class="fas fa-arrow-up"></i> Currently active
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-5">
        <div class="col-12">
            <h3 class="text-center mb-4">Quick Actions</h3>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-book fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Browse Books</h5>
                    <p class="card-text">Explore our extensive collection of books across various genres</p>
                    <a asp-controller="Books" asp-action="Index" class="btn btn-primary">
                        <i class="fas fa-book me-1"></i>View All Books
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-id-card fa-3x text-success mb-3"></i>
                    <h5 class="card-title">My Account</h5>
                    <p class="card-text">Manage your membership and view your personal information</p>
                    <a asp-controller="Members" asp-action="MyMembership" class="btn btn-success">
                        <i class="fas fa-id-card me-1"></i>My Membership
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card h-100 text-center shadow-sm">
                <div class="card-body">
                    <i class="fas fa-clipboard-list fa-3x text-info mb-3"></i>
                    <h5 class="card-title">My Issues</h5>
                    <p class="card-text">View your currently issued books and return history</p>
                    <a asp-controller="BookIssues" asp-action="MyIssues" class="btn btn-info">
                        <i class="fas fa-clipboard-list me-1"></i>View My Issues
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Books -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h4 class="mb-0"><i class="fas fa-clock me-2"></i>Recently Added Books</h4>
                </div>
                <div class="card-body">
                    @if (Model.RecentBooks.Any())
                    {
                        <div class="row">
                            @foreach (var book in Model.RecentBooks)
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="card h-100 shadow-sm">
                                        <div class="card-body">
                                            <h6 class="card-title text-primary">@book.Title</h6>
                                            <p class="card-text text-muted small">
                                                <i class="fas fa-user-edit me-1"></i>by @book.Author?.FullName<br>
                                                <i class="fas fa-barcode me-1"></i>ISBN: @book.ISBN<br>
                                                <i class="fas fa-copy me-1"></i>Available: @book.AvailableCopies of @book.TotalCopies
                                            </p>
                                            <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye me-1"></i>View Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No books available in the library yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Dynamic stats update for the home page
    $(document).ready(function() {
        function updateStatistics() {
            // Simulate dynamic data updates - you can replace this with actual API calls
            const books = @Model.TotalBooks + Math.floor(Math.random() * 10);
            const authors = @Model.TotalAuthors + Math.floor(Math.random() * 5);
            const members = @Model.TotalMembers + Math.floor(Math.random() * 8);
            const issued = @Model.IssuedBooks + Math.floor(Math.random() * 15);

            // Animate the number changes
            $('.stat-value').each(function(index) {
                const $this = $(this);
                const current = parseInt($this.text().replace(/,/g, ''));
                let newValue;

                switch(index) {
                    case 0: newValue = books; break;
                    case 1: newValue = authors; break;
                    case 2: newValue = members; break;
                    case 3: newValue = issued; break;
                }

                if (newValue !== current) {
                    $this.prop('Counter', current).animate({
                        Counter: newValue
                    }, {
                        duration: 1000,
                        easing: 'swing',
                        step: function (now) {
                            $this.text(Math.ceil(now).toLocaleString());
                        }
                    });
                }
            });
        }

        // Update statistics every 10 seconds to simulate dynamic data
        setInterval(updateStatistics, 10000);
    });
</script>